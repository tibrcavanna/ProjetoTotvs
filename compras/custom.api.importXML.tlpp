// ====== Busca Produto na SB1 por Código ======
	@Get( '/api/nfe/produto' )
User Function buscaProduto()

	Local jResponse := JsonObject():New()  As Json
	Local jProduto  := JsonObject():New()  As Json

	Local cCod      := ''                  As Character

	cCod := AllTrim( oRest:GetQueryString( 'cod' ) )

	DBSelectArea( 'SB1' )
	SB1->( DBSetOrder( 1 ) )

	IF !SB1->( Deleted() ) .AND. SB1->( MsSeek( xFilial( 'SB1' ) + cCod ) )

		jProduto[ 'cod'  ] := EncodeUTF8( AllTrim( SB1->B1_COD  ) )
		jProduto[ 'desc' ] := EncodeUTF8( AllTrim( SB1->B1_DESC ) )
		jProduto[ 'um'   ] := EncodeUTF8( AllTrim( SB1->B1_UM   ) )

		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Produto encontrado'
		jResponse[ 'data'    ] := jProduto

	Else

		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Produto não encontrado na SB1'

	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

// ====== Busca Códigos do Produto no Fornecedor via SA5 ======
@Post( '/api/nfe/codprf' )
User Function buscaCodPrf()

	Local jResponse := JsonObject():New()  As Json
	Local jBody     := JsonObject():New()  As Json
	Local jItem     := NIL                 As Json
	Local aItens    := {}                  As Array
	Local cFornece  := ''                  As Character
	Local cLoja     := ''                  As Character
	Local cProduto  := ''                  As Character
	Local cBodyRaw  := ''                  As Character

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )

	cBodyRaw := oRest:getBodyRequest()
	jBody    := JsonObject():New()

	IF jBody:FromJson( cBodyRaw ) != NIL
		oRest:setStatusCode( 400 )
		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'JSON inválido'
		oRest:SetResponse( jResponse:ToJson() )
		Return( .T. )
	EndIF

	cFornece := AllTrim( jBody[ 'fornecedor' ] )
	cLoja    := AllTrim( jBody[ 'loja'       ] )
	cProduto := AllTrim( jBody[ 'produto'    ] )  // A5_CODPRF (ex: 1600270103CROSS)

	IF Empty( cLoja )
		cLoja := '01'
	EndIF

	DBSelectArea( 'SA5' )
	SA5->( DBSetOrder( 14 ) )   // Ordem E: Filial + Fornece + Loja + CodPrf
	SA5->( MsSeek( FWxFilial( 'SA5' )                        + ;
		PadR( cFornece, TamSX3( 'A5_FORNECE' )[1] )          + ;
		PadR( cLoja,    TamSX3( 'A5_LOJA'    )[1] )          + ;
		PadR( cProduto, TamSX3( 'A5_CODPRF'  )[1] )          ) )

	While SA5->( !EoF() )                          .And. ;
			!SA5->( Deleted() )                    .And. ;
			SA5->A5_FILIAL   == FWxFilial( 'SA5' ) .And. ;
			AllTrim( SA5->A5_FORNECE ) == cFornece  .And. ;
			AllTrim( SA5->A5_LOJA    ) == cLoja     .And. ;
			AllTrim( SA5->A5_CODPRF  ) == cProduto

		jItem := JsonObject():New()
		jItem[ 'codPrf'  ] := EncodeUTF8( AllTrim( SA5->A5_CODPRF  ) )
		jItem[ 'descPrf' ] := EncodeUTF8( AllTrim( SA5->A5_DESCPRF ) )
		jItem[ 'produto' ] := EncodeUTF8( AllTrim( SA5->A5_PRODUTO ) )
		jItem[ 'nomprod' ] := EncodeUTF8( AllTrim( SA5->A5_NOMPROD ) )
		jItem[ 'ncm'     ] := EncodeUTF8( AllTrim( SA5->A5_NCMPRF  ) )
		aAdd( aItens, jItem )

		SA5->( DBSkip() )

	EndDo

	IF Len( aItens ) > 0
		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Produtos encontrados'
		jResponse[ 'total'   ] := Len( aItens )
		jResponse[ 'data'    ] := aItens
	Else
		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Nenhum produto encontrado na SA5 para este fornecedor'
	EndIF

	oRest:SetResponse( jResponse:ToJson() )

Return( .T. )


	@Post( '/api/nfe/pedidos' )
User Function listPedidos()

	Local jResponse := JsonObject():New()  As Json
	Local jBody     := JsonObject():New()  As Json
	Local jPedido   := NIL                 As Json
	Local aPedidos  := {}                  As Array
	Local cFornece  := ''                  As Character
	Local cLoja     := ''                  As Character
	Local cProduto  := ''                  As Character
	Local cBodyRaw  := ''                  As Character

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )

	cBodyRaw := oRest:getBodyRequest()
	jBody    := JsonObject():New()

	IF jBody:FromJson( cBodyRaw ) != NIL
		oRest:setStatusCode( 400 )
		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'JSON inválido'
		oRest:SetResponse( jResponse:ToJson() )
		Return( .T. )
	EndIF

	cFornece := AllTrim( jBody[ 'fornecedor' ] )
	cLoja    := AllTrim( jBody[ 'loja'       ] )
	cProduto := AllTrim( jBody[ 'produto'    ] )

	IF Empty( cLoja )
		cLoja := '01'
	EndIF

	DBSelectArea( 'SC7' )
	SC7->( DBSetOrder( 2 ) ) // Produto + Fornecedor + Loja + Numero PC
	SC7->( MsSeek( FWxFilial( 'SC7' )                      + ;
		PadR( cProduto, TamSX3( 'C7_PRODUTO' )[1] ) + ;
		PadR( cFornece, TamSX3( 'C7_FORNECE' )[1] ) + ;
		PadR( cLoja,    TamSX3( 'C7_LOJA'    )[1] ) ) )

	While SC7->( !EoF() )                              .And. ;
			!SC7->( Deleted() )                          .And. ;
			SC7->C7_FILIAL   == FWxFilial( 'SC7' )       .And. ;
			AllTrim( SC7->C7_PRODUTO ) == cProduto        .And. ;
			AllTrim( SC7->C7_FORNECE ) == cFornece        .And. ;
			AllTrim( SC7->C7_LOJA    ) == cLoja

		IF ( SC7->C7_QUANT - SC7->C7_QUJE ) > 0
			jPedido := JsonObject():New()
			jPedido[ 'numPed' ] := EncodeUTF8( AllTrim( SC7->C7_NUM     ) )
			jPedido[ 'item'   ] := EncodeUTF8( AllTrim( SC7->C7_ITEM    ) )
			jPedido[ 'cod'    ] := EncodeUTF8( AllTrim( SC7->C7_PRODUTO ) )
			jPedido[ 'desc'   ] := EncodeUTF8( AllTrim( SC7->C7_DESCRI  ) )
			jPedido[ 'quant'  ] := SC7->C7_QUANT - SC7->C7_QUJE
			jPedido[ 'valor'  ] := SC7->C7_PRECO
			aAdd( aPedidos, jPedido )
		EndIF

		SC7->( DBSkip() )

	EndDo

	IF Len( aPedidos ) > 0
		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Pedidos encontrados'
		jResponse[ 'total'   ] := Len( aPedidos )
		jResponse[ 'data'    ] := aPedidos
	Else
		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Nenhum pedido encontrado para este fornecedor'
	EndIF

	oRest:SetResponse( jResponse:ToJson() )

Return( .T. )



// ====== Busca Pedido de Compra na SC7 por Número + Item ======
	@Get( '/api/nfe/pedido' )
User Function buscaPedido()

	Local jResponse := JsonObject():New()  As Json
	Local jPedido   := JsonObject():New()  As Json

	Local cNum      := ''                  As Character
	Local cItem     := ''                  As Character

	cNum  := AllTrim( oRest:getQueryParam( 'num'  ) )
	cItem := AllTrim( oRest:getQueryParam( 'item' ) )

	DBSelectArea( 'SC7' )
	SC7->( DBSetOrder( 1 ) )

	IF SC7->( MsSeek( xFilial( 'SC7' ) + cNum + cItem ) )

		jPedido[ 'numPed' ] := EncodeUTF8( AllTrim( SC7->C7_NUM     ) )
		jPedido[ 'item'   ] := EncodeUTF8( AllTrim( SC7->C7_ITEM    ) )
		jPedido[ 'cod'    ] := EncodeUTF8( AllTrim( SC7->C7_PRODUTO ) )
		jPedido[ 'desc'   ] := EncodeUTF8( AllTrim( SC7->C7_DESCRI  ) )
		jPedido[ 'quant'  ] := SC7->C7_QUANT
		jPedido[ 'valor'  ] := SC7->C7_PRECO

		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Pedido encontrado'
		jResponse[ 'data'    ] := jPedido

	Else

		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Pedido não encontrado na SC7'

	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

// ====== Lista todas as TES da SF4 ======
	@Get( '/api/nfe/tes' )
User Function listTes()

	Local jResponse := JsonObject():New()  As Json
	Local jTes      := NIL                 As Json

	Local aTes      := {}                  As Array

	DBSelectArea( 'SF4' )
	SF4->( DBSetOrder( 1 ) )
	SF4->( DBGoTop() )

	While SF4->( !EoF() )

		IF !SF4->( Deleted() ) .AND. SF4->F4_FILIAL == FWxFilial( 'SF4' )

			jTes := JsonObject():New()
			jTes[ 'cod'    ] := EncodeUTF8( AllTrim( SF4->F4_CODIGO ) )
			jTes[ 'descri' ] := EncodeUTF8( AllTrim( SF4->F4_TEXTO  ) )
			jTes[ 'tipo'   ] := EncodeUTF8( AllTrim( SF4->F4_TIPO   ) )

			aAdd( aTes, jTes )

		EndIF

		SF4->( DBSkip() )

	EndDo

	IF Len( aTes ) > 0
		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'TES encontradas'
		jResponse[ 'total'   ] := Len( aTes )
		jResponse[ 'data'    ] := aTes
	Else
		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Nenhuma TES encontrada'
	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

// ====== Busca TES na SF4 por Código ======
	@Get( '/api/nfe/te' )
User Function buscaTes()

	Local jResponse := JsonObject():New()  As Json
	Local jTes      := JsonObject():New()  As Json

	Local cCod      := ''                  As Character

	cCod := AllTrim( oRest:getQueryParam( 'cod' ) )

	DBSelectArea( 'SF4' )
	SF4->( DBSetOrder( 1 ) )

	IF SF4->( MsSeek( xFilial( 'SF4' ) + cCod ) )

		jTes[ 'cod'    ] := EncodeUTF8( AllTrim( SF4->F4_CODIGO ) )
		jTes[ 'descri' ] := EncodeUTF8( AllTrim( SF4->F4_TEXTO  ) )
		jTes[ 'tipo'   ] := EncodeUTF8( AllTrim( SF4->F4_TIPO   ) )

		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'TES encontrada'
		jResponse[ 'data'    ] := jTes

	Else

		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'TES não encontrada na SF4'

	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

// ====== Lista todas as Condições de Pagamento da SE4 ======
	@Get( '/api/nfe/condicoes' )
User Function listCondicoes()

	Local jResponse  := JsonObject():New()  As Json
	Local jCond      := NIL                 As Json

	Local aCondicoes := {}                  As Array

	DBSelectArea( 'SE4' )
	SE4->( DBSetOrder( 1 ) )
	SE4->( DBGoTop() )

	While SE4->( !EoF() )

		IF !SE4->( Deleted() ) .AND. SE4->E4_FILIAL == FWxFilial( 'SE4' )

			jCond := JsonObject():New()
			jCond[ 'cod'    ] := EncodeUTF8( AllTrim( SE4->E4_CODIGO ) )
			jCond[ 'descri' ] := EncodeUTF8( AllTrim( SE4->E4_DESCRI ) )
			jCond[ 'tipo'   ] := EncodeUTF8( AllTrim( SE4->E4_TIPO   ) )

			aAdd( aCondicoes, jCond )

		EndIF

		SE4->( DBSkip() )

	EndDo

	IF Len( aCondicoes ) > 0
		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Condições encontradas'
		jResponse[ 'total'   ] := Len( aCondicoes )
		jResponse[ 'data'    ] := aCondicoes
	Else
		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Nenhuma condição encontrada'
	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

// ====== Busca Condição de Pagamento na SE4 por Código ======
	@Get( '/api/nfe/condicao' )
User Function buscaCondicao()

	Local jResponse := JsonObject():New()  As Json
	Local jCond     := JsonObject():New()  As Json

	Local cCod      := ''                  As Character

	cCod := AllTrim( oRest:getQueryParam( 'cod' ) )

	DBSelectArea( 'SE4' )
	SE4->( DBSetOrder( 1 ) )

	IF SE4->( MsSeek( xFilial( 'SE4' ) + cCod ) )

		jCond[ 'cod'    ] := EncodeUTF8( AllTrim( SE4->E4_CODIGO ) )
		jCond[ 'descri' ] := EncodeUTF8( AllTrim( SE4->E4_DESCRI ) )
		jCond[ 'tipo'   ] := EncodeUTF8( AllTrim( SE4->E4_TIPO   ) )

		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Condição encontrada'
		jResponse[ 'data'    ] := jCond

	Else

		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Condição de pagamento não encontrada na SE4'

	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )
