#INCLUDE 'TLPP-CORE.TH'
#INCLUDE 'TLPP-REST.TH'

Namespace custom.nfe.poui

// ====== Lista todos os Fornecedores da SA2 ======
@Get( '/api/nfe/fornecedores' )
User Function listFornecedor()

	Local jResponse     := JsonObject():New()  As Json
	Local jFornecedor   := NIL                 As Json

	Local aFornecedores := {}                  As Array

	DBSelectArea( 'SA2' )
	SA2->( DBSetOrder( 1 ) )
	SA2->( DBGoTop() )

	While SA2->( !EoF() )

		IF !SA2->( Deleted() )

			jFornecedor := JsonObject():New()
			jFornecedor[ 'cod'  ] := EncodeUTF8( AllTrim( SA2->A2_COD  ) )
			jFornecedor[ 'loja' ] := EncodeUTF8( AllTrim( SA2->A2_LOJA ) )
			jFornecedor[ 'nome' ] := EncodeUTF8( AllTrim( SA2->A2_NOME ) )
			jFornecedor[ 'cnpj' ] := EncodeUTF8( AllTrim( SA2->A2_CGC  ) )
			jFornecedor[ 'uf'   ] := EncodeUTF8( AllTrim( SA2->A2_EST  ) )

			aAdd( aFornecedores, jFornecedor )

		EndIF

		SA2->( DBSkip() )

	EndDo

	IF Len( aFornecedores ) > 0
		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Fornecedores encontrados'
		jResponse[ 'total'   ] := Len( aFornecedores )
		jResponse[ 'data'    ] := aFornecedores
	Else
		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Nenhum fornecedor encontrado'
	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

// ====== Busca Fornecedor na SA2 por Código ======
	@Get( '/api/nfe/fornecedor' )
User Function buscaFornecedor()

	Local jResponse   := JsonObject():New()  As Json
	Local jFornecedor := JsonObject():New()  As Json

	Local cCod        := ''                  As Character
	Local cLoja       := ''                  As Character

	cCod  := AllTrim( oRest:getQueryParam( 'cod'  ) )
	cLoja := AllTrim( oRest:getQueryParam( 'loja' ) )

	IF Empty( cLoja )
		cLoja := '01'
	EndIF

	DBSelectArea( 'SA2' )
	SA2->( DBSetOrder( 1 ) )
	SA2->( MsSeek( xFilial( 'SA2' ) + cCod + cLoja ) )

	IF !SA2->( EoF() ) .AND. AllTrim( SA2->A2_COD ) == cCod .AND. AllTrim( SA2->A2_LOJA ) == cLoja

		jFornecedor[ 'cod'  ] := EncodeUTF8( AllTrim( SA2->A2_COD  ) )
		jFornecedor[ 'loja' ] := EncodeUTF8( AllTrim( SA2->A2_LOJA ) )
		jFornecedor[ 'nome' ] := EncodeUTF8( AllTrim( SA2->A2_NOME ) )
		jFornecedor[ 'cnpj' ] := EncodeUTF8( AllTrim( SA2->A2_CGC  ) )
		jFornecedor[ 'uf'   ] := EncodeUTF8( AllTrim( SA2->A2_EST  ) )

		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Fornecedor encontrado'
		jResponse[ 'data'    ] := jFornecedor

	Else

		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Fornecedor não encontrado'

	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

// ====== Lista todas as Transportadoras da SA4 ======
	@Get( '/api/nfe/transportadoras' )
User Function listTransp()

	Local jResponse        := JsonObject():New()  As Json
	Local jTransportadora  := NIL                 As Json

	Local aTransportadoras := {}                  As Array

	DBSelectArea( 'SA4' )
	SA4->( DBSetOrder( 1 ) )
	SA4->( DBGoTop() )

	While SA4->( !EoF() )

		IF !SA4->( Deleted() )

			jTransportadora := JsonObject():New()
			jTransportadora[ 'cod'  ] := EncodeUTF8( AllTrim( SA4->A4_COD  ) )
			jTransportadora[ 'nome' ] := EncodeUTF8( AllTrim( SA4->A4_NOME ) )
			jTransportadora[ 'cnpj' ] := EncodeUTF8( AllTrim( SA4->A4_CGC  ) )

			aAdd( aTransportadoras, jTransportadora )

		EndIF

		SA4->( DBSkip() )

	EndDo

	IF Len( aTransportadoras ) > 0
		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Transportadoras encontradas'
		jResponse[ 'total'   ] := Len( aTransportadoras )
		jResponse[ 'data'    ] := aTransportadoras
	Else
		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Nenhuma transportadora encontrada'
	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

