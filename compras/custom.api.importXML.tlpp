// ====== Lista todas as Mensagens Padrão da SM4 ======
	@Get( '/api/nfe/mensagens' )
User Function nfeMensagens()

	Local jResponse  := JsonObject():New()  As Json
	Local jMensagem  := NIL                 As Json

	Local aMensagens := {}                  As Array

	DBSelectArea( 'SM4' )
	SM4->( DBSetOrder( 1 ) )
	SM4->( DBGoTop() )

	While SM4->( !EoF() )

		IF !SM4->( Deleted() ) .AND. SM4->M4_FILIAL == FWxFilial( 'SM4' )

			jMensagem := JsonObject():New()
			jMensagem[ 'cod'    ] := EncodeUTF8( AllTrim( SM4->M4_CODIGO ) )
			jMensagem[ 'descri' ] := EncodeUTF8( AllTrim( SM4->M4_DESCR  ) )

			aAdd( aMensagens, jMensagem )

		EndIF

		SM4->( DBSkip() )

	EndDo

	IF Len( aMensagens ) > 0
		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Mensagens encontradas'
		jResponse[ 'total'   ] := Len( aMensagens )
		jResponse[ 'data'    ] := aMensagens
	Else
		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Nenhuma mensagem encontrada'
	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

// ====== Busca Mensagem Padrão na SM4 por Código ======
	@Get( '/api/nfe/mensagem' )
User Function nfeMensagem()

	Local jResponse := JsonObject():New()  As Json
	Local jMensagem := JsonObject():New()  As Json

	Local cCod      := ''                  As Character

	cCod := AllTrim( oRest:getQueryParam( 'cod' ) )

	DBSelectArea( 'SM4' )
	SM4->( DBSetOrder( 1 ) )
	SM4->( MsSeek( xFilial( 'SM4' ) + cCod ) )

	IF !SM4->( EoF() ) .AND. SM4->M4_FILIAL == FWxFilial( 'SM4' ) .AND. AllTrim( SM4->M4_CODIGO ) == cCod

		jMensagem[ 'cod'     ] := EncodeUTF8( AllTrim( SM4->M4_CODIGO ) )
		jMensagem[ 'descri'  ] := EncodeUTF8( AllTrim( SM4->M4_DESCR  ) )
		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Mensagem encontrada'
		jResponse[ 'data'    ] := jMensagem

	Else

		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Mensagem não encontrada'

	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

